<!-- SCRIPT GERAL E PERSISTÊNCIA -->
<script>
    // Carrega dados salvos do localStorage ao abrir a página
    document.addEventListener('DOMContentLoaded', function() {
        loadSavedData();
    });

    // Função para Salvar Alterações no Navegador
    function saveData() {
        const dataToSave = {
            irlanda: document.getElementById('irlanda').innerHTML,
            londres: document.getElementById('londres').innerHTML,
            panorama: document.getElementById('panorama').innerHTML
        };
        localStorage.setItem('eurotrip_2026_content', JSON.stringify(dataToSave));
    }

    // Função para Carregar Conteúdo Salvo
    function loadSavedData() {
        const savedData = localStorage.getItem('eurotrip_2026_content');
        if (savedData) {
            try {
                const data = JSON.parse(savedData);
                if (data.irlanda) document.getElementById('irlanda').innerHTML = data.irlanda;
                if (data.londres) document.getElementById('londres').innerHTML = data.londres;
                if (data.panorama) document.getElementById('panorama').innerHTML = data.panorama;
            } catch (e) {
                console.error('Erro ao restaurar edições salvas:', e);
            }
        }
    }

    // Função para Resetar para o Roteiro Original
    function resetData() {
        if (confirm('Tem certeza que deseja apagar todas as suas edições e voltar ao roteiro original?')) {
            localStorage.removeItem('eurotrip_2026_content');
            location.reload();
        }
    }

    // Função para Abrir e Fechar os Cards
    function toggleCard(headerElement) {
        if (document.body.getAttribute('contenteditable') === 'true') return;
        const card = headerElement.parentElement;
        card.classList.toggle('active');
    }

    // Lógica das Abas Superiores
    function openTab(tabId) {
        if (document.body.getAttribute('contenteditable') === 'true') return;

        const contents = document.querySelectorAll('.tab-content');
        contents.forEach(content => content.classList.remove('active'));

        const btns = document.querySelectorAll('.tab-btn');
        btns.forEach(btn => btn.classList.remove('active'));

        document.getElementById(tabId).classList.add('active');
        event.currentTarget.classList.add('active');
    }

    // Lógica do Botão Global de Edição (Editar / Salvar)
    document.getElementById('btn-edit-global').addEventListener('click', function(e) {
        const body = document.body;
        const isEditing = body.getAttribute('contenteditable') === 'true';
        
        if (isEditing) {
            // Desativa Edição e SALVA
            body.setAttribute('contenteditable', 'false');
            saveData(); // <--- Grava no localStorage
            this.innerHTML = '✏️ Editar Roteiro';
            this.style.backgroundColor = 'var(--alert-dica)';
            this.style.color = '#000';
            
            // Alerta discreto confirmando o salvamento
            alert('✅ Alterações salvas no seu navegador com sucesso!');
        } else {
            // Ativa Edição
            body.setAttribute('contenteditable', 'true');
            this.innerHTML = '💾 Salvar Alterações';
            this.style.backgroundColor = 'var(--primary)';
            this.style.color = '#fff';

            // Abre todos os cards automaticamente para facilitar a visualização durante a edição
            document.querySelectorAll('.card').forEach(card => card.classList.add('active'));
        }
    });
</script>


