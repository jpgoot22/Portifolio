    <div class="tab-container" contenteditable="false">
        <button class="tab-btn active" onclick="openTab('irlanda')">🇮🇪 Irlanda (Cork)</button>
        <button class="tab-btn" onclick="openTab('londres')">🇬🇧 Londres</button>
        <button class="tab-btn" onclick="openTab('panorama')">✈️ Panorama Completo</button>
