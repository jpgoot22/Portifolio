                            <tr><td>09:00</td><td>English Market — Queijos, Brown Bread e produtos locais</td></tr>
                            <tr><td>10:30</td><td>St. Fin Barre's Cathedral</td></tr>
                            <tr><td>11:45</td><td>Elizabeth Fort</td></tr>
