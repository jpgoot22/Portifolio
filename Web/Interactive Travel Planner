<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eurotrip 2026 - Irlanda & Londres</title>
    
    <style>
        /* Variáveis de Cor (Dark Theme Moderno) */
        :root {
            --bg-body: #0f172a;
            --bg-card: #1e293b;
            --bg-card-hover: #334155;
            --primary: #10b981;
            --primary-hover: #059669;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #334155;
            
            /* Cores de Alerta */
            --alert-atencao: #ef5350;
            --alert-dica: #ffca28;
            --alert-transporte: #42a5f5;
            --alert-clima: #26c6da;
            --alert-reserva: #ab47bc;

            /* Cores de Dificuldade */
            --diff-leve: #10b981;
            --diff-moderado: #f59e0b;
            --diff-moderado-alto: #f97316;
            --diff-alto: #ef4444;
        }

        /* Reset Geral */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            line-height: 1.6;
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
            transition: outline 0.3s;
        }

        /* Indicador visual de quando o modo de edição está ativo */
        body[contenteditable="true"] {
            outline: 3px dashed var(--primary);
            outline-offset: -5px;
            background-color: #0d1425;
        }

        /* Cabeçalho Principal */
        header { 
            text-align: center; 
            margin-bottom: 24px; 
            padding: 20px; 
            background: linear-gradient(135deg, #064e3b 0%, #022c22 100%); 
            border: 1px solid #047857; 
            border-radius: 10px; 
        }
        header h1 { font-size: 1.8rem; margin-bottom: 8px; color: #fff; }
        header p { color: #a7f3d0; font-size: 1rem; }
        .meta-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 12px; }
        .badge { background-color: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.2); padding: 4px 10px; border-radius: 12px; font-size: 0.85rem; }

        /* Abas (Tabs) */
        .tab-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .tab-btn {
            background-color: var(--bg-card);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1em;
            font-weight: bold;
            transition: all 0.2s;
        }
        .tab-btn:hover { background-color: var(--bg-card-hover); }
        .tab-btn.active {
            background-color: var(--primary);
            color: #000;
            border-color: var(--primary);
        }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.3s ease-in-out; }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2 { color: var(--primary); margin: 30px 0 15px 0; border-bottom: 1px solid var(--border-color); padding-bottom: 5px; }
        h3 { color: var(--primary); margin: 20px 0 10px 0; font-size: 1.2em; }

        /* Tabelas Gerais */
        table { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 0.9em; }
        th, td { padding: 10px; border: 1px solid var(--border-color); text-align: left; }
        th { background-color: rgba(255,255,255,0.05); color: var(--primary); }

        /* LAYOUT DOS CARDS */
        .roteiro-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            align-items: start;
        }
        @media (min-width: 768px) { .roteiro-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (min-width: 1024px) { .roteiro-grid { grid-template-columns: repeat(3, 1fr); } }

        .card {
            background-color: var(--bg-card);
            border-radius: 10px;
            width: 100%;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            margin-bottom: 20px; 
        }

        .roteiro-grid .card { margin-bottom: 0; }

        .card-header {
            padding: 16px;
            cursor: pointer;
            transition: background 0.2s;
            user-select: none;
        }
        .card-header:hover { background-color: var(--bg-card-hover); }
        .card-title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .card-title { font-size: 1.1em; font-weight: bold; color: #fff; display: flex; align-items: center; }
        .toggle-icon { transition: transform 0.3s ease; font-size: 0.8em; background: var(--bg-body); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
        
        .info-rapida { display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.8em; color: var(--text-muted); }
        .info-rapida span { background: rgba(0,0,0,0.3); padding: 4px 8px; border-radius: 6px; display: inline-flex; align-items: center; }

        .card-content {
            max-height: 0;
            opacity: 0;
            padding: 0 16px;
            background-color: var(--bg-body);
            transition: max-height 0.4s ease-in-out, opacity 0.3s ease-in-out, padding 0.3s ease-in-out;
        }
        
        .card.active .toggle-icon { transform: rotate(180deg); background: var(--primary); color: #000; }
        .card.active .card-content { 
            max-height: 4000px;
            opacity: 1;
            padding: 16px;
            border-top: 1px solid var(--border-color); 
        }

        .secao { margin: 15px 0; }
        .secao h4 { font-size: 1em; color: var(--primary); margin-bottom: 8px; }
        .secao p { font-size: 0.9em; margin-bottom: 8px; color: #cbd5e1; }
        .secao ul { padding-left: 20px; font-size: 0.9em; color: #cbd5e1; margin-bottom: 8px; }
        .secao ul li { margin-bottom: 4px; }

        .box { padding: 10px 12px; margin: 12px 0; border-radius: 0 6px 6px 0; border-left: 4px solid; background: rgba(255, 255, 255, 0.03); font-size: 0.85em; color: #e2e8f0; }
        .box strong { display: block; margin-bottom: 4px; font-size: 1.05em; }
        .box.atencao { border-color: var(--alert-atencao); background: rgba(239, 83, 80, 0.1); }
        .box.dica { border-color: var(--alert-dica); }
        .box.transporte { border-color: var(--alert-transporte); background: rgba(66, 165, 245, 0.1); }
        .box.reserva { border-color: var(--alert-reserva); background: rgba(171, 71, 188, 0.1); }

        /* Timeline Panorama */
        .timeline { position: relative; max-width: 800px; margin: 0 auto; padding: 20px 0; }
        .timeline::after { content: ''; position: absolute; width: 2px; background: var(--border-color); top: 0; bottom: 0; left: 20px; }
        .t-item { padding: 10px 0 20px 50px; position: relative; }
        .t-item::after { content: ''; position: absolute; width: 16px; height: 16px; right: auto; left: 13px; top: 15px; background: var(--bg-body); border: 3px solid var(--primary); border-radius: 50%; z-index: 1; }
        .t-date { font-weight: bold; color: var(--primary); display: block; margin-bottom: 5px; }
        .t-content { background: var(--bg-card); padding: 15px; border-radius: 8px; border: 1px solid var(--border-color); }
        .t-content h3 { font-size: 1.1em; color: #fff; margin-bottom: 5px; }
        .t-content p { font-size: 0.9em; color: var(--text-muted); }

        /* Area de Botoes de Ação */
        .action-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 30px;
        }

        .btn-action {
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: bold;
            transition: all 0.2s;
        }
        .btn-action:hover { transform: scale(1.05); }

        .btn-edit { background-color: var(--alert-dica); color: #000; }
        .btn-reset { background-color: rgba(239, 83, 80, 0.2); color: var(--alert-atencao); border: 1px solid var(--alert-atencao); }
        .btn-reset:hover { background-color: var(--alert-atencao); color: #fff; }

    </style>
</head>
<body>

    <header>
        <h1>🌍 Eurotrip 2026</h1>
        <p>Irlanda & Londres</p>
        <div class="meta-badges">
            <span class="badge">👥 7 Adultos</span>
            <span class="badge">📅 04/09 a 13/09</span>
        </div>
