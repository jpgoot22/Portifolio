    <div id="londres" class="tab-content">
        
        <h2>Itinerário Diário: Londres (3 Dias)</h2>

        <div class="roteiro-grid" style="margin-bottom: 40px;">
            <div class="card">
                <div class="card-header" onclick="toggleCard(this)">
